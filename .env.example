# Скопируйте в .env и задайте значения. НЕ коммитьте .env.
COMPOSE_PROJECT_NAME=alageum
APP_VERSION=0.1.0
APP_ENV=demo                  # dev | test | demo | pilot
APP_PUBLIC_URL=auto
APP_CLOCK_MODE=fixed          # system (pilot) | fixed | shifted (demo)
APP_FIXED_NOW=2026-03-16T10:00:00Z

POSTGRES_DB=alageum
POSTGRES_USER=alageum_app
POSTGRES_PASSWORD=Tulpar_47_Dala_82
SECRET_KEY=Samal_73_Arna_28_Tulpar_95_Dala_46
COOKIE_SECURE=false            # true для HTTPS (обязательно в pilot)

# сеанс входа: выход после 10 минут без действий (любая активность продлевает), предел — 8 часов
SESSION_IDLE_TTL_MINUTES=10
SESSION_ABS_TTL_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
WORKER_ENABLED=true
LOG_LEVEL=INFO

# Demo (запрещено в pilot)
ALLOW_DEMO_SEED=true
DEMO_USER_PASSWORD=            # минимум 12 символов; задаётся скриптом gen-secrets.sh

WEB_HTTP_PORT=8100
WEB_HTTPS_PORT=8443
# DNS для кэша плиток карты (через пробел); по умолчанию 1.1.1.1 8.8.8.8 127.0.0.11
# TILE_DNS=
